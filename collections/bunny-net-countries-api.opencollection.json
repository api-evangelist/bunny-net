{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bunny.net Core Platform APIKeys Countries API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "AccessKey",
      "value": "{{AccessKey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Countries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get country list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bunny.net/countries"
          },
          "docs": "Get country list"
        }
      ]
    }
  ],
  "bundled": true
}